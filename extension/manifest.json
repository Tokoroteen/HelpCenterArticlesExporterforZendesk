{
  "manifest_version": 3,
  "name": "Help Center Articles Exporter for Zendesk",
  "version": "1.0.0",
  "description": "Export Zendesk Help Center articles to CSV or Markdown",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*/hc/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/hc/*"],
      "js": ["vendor/turndown.browser.umd.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
